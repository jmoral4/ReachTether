  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenAI" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ReachyMini.Sdk\ReachyMini.Sdk.csproj" />
    <ProjectReference Include="..\..\src\ReachyMini.Audio\ReachyMini.Audio.csproj" />
    <ProjectReference Include="..\..\src\ReachyMini.Audio.Alsa\ReachyMini.Audio.Alsa.csproj" />
    <ProjectReference Include="..\..\src\ReachyMini.WebRtc\ReachyMini.WebRtc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
