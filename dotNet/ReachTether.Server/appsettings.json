{
  "OpenAI": {
    "BaseUrl": "https://api.openai.com/v1/",
    "SmartyModel": "gpt-5.4",
    "FastExtractionModel": "gpt-5-mini",
    "FastExtractionFallbackModel": "gpt-5-nano",
    "EmbeddingsModel": "text-embedding-3-small"
  },
  "Memory": {
    "DatabasePath": "data/reachtether-server.db",
    "PreferredEmbeddingProvider": "local",
    "FallbackEmbeddingProvider": "openai",
    "LocalEmbeddings": {
      "Enabled": false
    }
  },
  "Snapshots": {
    "StoragePath": "data/snapshots"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
