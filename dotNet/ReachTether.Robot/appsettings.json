{
  "ReachyMini": {
    "BaseUrl": "http://reachy-mini.local:8000"
  },
  "Audio": {
    "CaptureDevice": "reachymini_audio_src",
    "PlaybackDevice": "reachymini_audio_sink",
    "SampleRateHz": 16000,
    "Channels": 2
  },
  "Personality": {
    "CatalogPath": "personalities.json",
    "Default": "bored teen"
  },
  "Motion": {
    "Enabled": true,
    "LoopHz": 50,
    "MetricsIntervalSeconds": 10,
    "CommandThresholdMm": 0.25,
    "CommandThresholdDeg": 0.35,
    "MaxTranslationMm": 15.0,
    "MaxRotationDeg": 20.0,
    "TalkingSilenceReleaseMs": 150,
    "TalkingDecaySeconds": 0.25
  },
  "Vision": {
    "Enabled": true,
    "SnapshotCacheMs": 500,
    "AmbientContextEnabled": false,
    "AmbientContextIntervalSeconds": 5.0,
    "FaceTrackingEnabled": false,
    "FaceTrackingHz": 5,
    "WarmupOnStartup": true,
    "WarmupDelayMs": 500,
    "ProbeOnStartup": false,
    "ProbeOnly": false,
    "ProbeCaptureCount": 1,
    "ProbeDelayMs": 1000,
    "SourceKind": "unix-socket",
    "SourcePath": "/tmp/reachymini_camera_socket",
    "Width": 1280,
    "Height": 720,
    "Framerate": 30,
    "CaptureTimeoutSeconds": 20
  },
  "Diagnostics": {
    "LogResponsesApiBodies": true,
    "ResponsesApiBodyMaxChars": 12000
  },
  "Server": {
    "Enabled": false,
    "BaseUrl": "http://localhost:5057",
    "TimeoutSeconds": 10,
    "UploadSnapshots": true,
    "SessionKey": "reachy-default",
    "UserId": "reachy-mini",
    "Lane": "voice"
  },
  "Tools": {
    "EnableRemoteTools": true,
    "RemoteTimeoutSeconds": 20
  },
  "Logging": {
    "LogLevel": {
      "System.Net.Http.HttpClient.ReachyMiniClient.LogicalHandler": "Warning",
      "System.Net.Http.HttpClient.ReachyMiniClient.ClientHandler": "Warning"
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "FileNamePrefix": "robot",
      "MinimumLevel": "Debug",
      "MaxFileSizeKb": 256,
      "RetainedFileCount": 4
    }
  },
  "VAD": {
    "PreRollMs": 300,
    "StartTriggerFrames": 3,
    "EndSilenceMs": 700,
    "MaxUtteranceMs": 8000,
    "ListenTimeoutMs": 20000,
    "MinRms": 0.012,
    "InitialNoiseFloorRms": 0.006,
    "NoiseFloorAdaptation": 0.05,
    "NoiseMultiplier": 2.2,
    "MaxNoiseFloorRms": 0.03
  },
  "OpenAI": {
    "VoicePipeline": "realtime",
    "ChatModel": "gpt-5.6-luna@low",
    "FallbackChatModel": "gpt-5.6-luna@low",
    "TranscriptionModel": "gpt-4o-transcribe",
    "SpeechModel": "gpt-4o-mini-tts",
    "SpeechVoice": "alloy",
    "TranscriptionLanguage": "en",
    "Realtime": {
      "Model": "gpt-realtime-2.1",
      "ResponseTimeoutMs": 45000,
      "InputSampleRateHz": 24000,
      "OutputSampleRateHz": 24000,
      "SpeechStopMicDisableGraceMs": 300,
      "InputChannelStrategy": "channel0",
      "RequireTranscriptBeforeAssistantAudio": false,
      "LogAverageDownmixInputLevels": false,
      "BenignErrorCodes": [
        "input_audio_buffer_commit_empty",
        "conversation_already_has_active_response"
      ]
    }
  }
}
